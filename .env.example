# LungAI Configuration

# API Settings
LUNGAI_API_HOST=0.0.0.0
LUNGAI_API_PORT=8000
LUNGAI_ENVIRONMENT=development
LUNGAI_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dataset Paths
# Point these to your local LUNA16 extraction directories
LUNGAI_DATA_DIR=./data
LUNGAI_RAW_DIR=./data/raw
LUNGAI_PROCESSED_DIR=./data/processed
LUNGAI_ANNOTATIONS_CSV=./data/raw/annotations.csv
LUNGAI_CANDIDATES_CSV=./data/raw/candidates.csv

# Preprocessing & Windowing Defaults
LUNGAI_WINDOW_CENTER=-600.0
LUNGAI_WINDOW_WIDTH=1500.0
LUNGAI_PATCH_SIZE=[32, 32, 32]
LUNGAI_TARGET_SPACING=[1.0, 1.0, 1.0]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
